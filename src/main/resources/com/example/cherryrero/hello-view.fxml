<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cherryrero.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="urlLink" prefWidth="200.0" promptText="Укажите url радио"/>
    <Button text="Hello!" onAction="#playRadio"/>
    <Button fx:id="pause" text="→" prefWidth="60.0" onAction="#pauseAudio"/>
</VBox>
