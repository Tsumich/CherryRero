<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<SplitPane dividerPositions="0.6" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.cherryrero.HelloController">

    <VBox alignment="CENTER" spacing="20.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        <TextField fx:id="urlLink" VBox.vgrow="ALWAYS" promptText="Укажите url радио"/>
        <StackPane fx:id="imageContainer"
                   style="-fx-background-color: #e0e0e0; -fx-border-color: #999; -fx-border-width: 1;">
            <ImageView fx:id="coverImage" fitWidth="300" fitHeight="300" preserveRatio="true"/>
            <Label fx:id="placeholderLabel" text="Обложка трека" style="-fx-text-fill: #666;"/>
        </StackPane>

        <HBox alignment="CENTER" spacing="15.0">
            <Button fx:id="playButton" text="▶ Запустить" prefWidth="120.0" onAction="#playAudio"/>
            <Button fx:id="pauseButton" text="⏸ Пауза" prefWidth="100.0" onAction="#pauseAudio"/>
            <Button fx:id="nextButton" text="⏭ Следующее" prefWidth="120.0" onAction="#nextAudio"/>
        </HBox>
    </VBox>

    <VBox spacing="10.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        <Label text="Плейлист"/>
        <TextArea fx:id="infoArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true"/>
    </VBox>

</SplitPane>