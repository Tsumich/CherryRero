<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Rectangle2D?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane"
            fx:controller="com.example.cherryrero.MainController">
    <top>
        <MenuBar>
            <Menu text="Файл">
                <MenuItem text="Указать путь к папке с музыкой..." onAction="#chooseFolder"/>
                <MenuItem text="Просмотреть логи" onAction="#openLogsWindow"/>
            </Menu>
            <Menu text="Вид">
                <CheckMenuItem fx:id="showLogsCheckItem" text="Отображать логи в приложении" onAction="#toggleLogsPanel"/>
                <CheckMenuItem fx:id="showCheckLightTheme" text="Светлая тема" onAction="#toggleTheme"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <HBox>
            <!-- ЛЕВАЯ ЧАСТЬ (Плеер) -->
            <VBox alignment="CENTER" spacing="20.0"
                  prefWidth="320.0" minWidth="380.0" maxWidth="320.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>

                <StackPane fx:id="imageContainer"
                           prefWidth="250.0" prefHeight="200.0" maxWidth="200.0" maxHeight="200.0">
                    <ImageView fx:id="currentProduct" pickOnBounds="true" preserveRatio="false"
                               fitHeight="200.0" fitWidth="200.0">
                        <Image url="@/cat.jpeg"/>
                    </ImageView>
                </StackPane>

                <Label fx:id="songTitle" text="Без названия - Неизвестен" styleClass="song-title"/>

                <HBox alignment="CENTER" spacing="15.0">
                    <Button fx:id="pauseButton" text="⏸ Пауза" prefWidth="100.0" onAction="#pauseAudio"/>
                    <Button fx:id="nextButton" text="⏭ Следующее" prefWidth="120.0" onAction="#nextAudio"/>
                </HBox>
            </VBox>

            <!-- ПРАВАЯ ЧАСТЬ (Вкладки) -->
            <VBox spacing="10.0" styleClass="VBox" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <padding >
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" >
                    <Tab text="🎵 Плейлист" >
                        <VBox spacing="10.0" styleClass="VBox">
                            <padding>
                                <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
                            </padding>
                            <HBox alignment="CENTER_LEFT" spacing="10.0"  >
                                <Label text="Мои треки" style="-fx-font-weight: bold; -fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
                                <Button text="📁 Папка" onAction="#chooseFolder"/>
                            </HBox>
                            <Label fx:id="folderPathLabel" text="Папка не выбрана" styleClass="cur_directory" wrapText="true"/>
                            <ListView fx:id="playlistView" VBox.vgrow="ALWAYS" onMouseClicked="#onTrackSelected"/>
                        </VBox>
                    </Tab>

                    <!-- Вкладка 2: Радио -->
                    <Tab text="📻 Радио" >
                        <VBox spacing="15.0">
                            <padding>
                                <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
                            </padding>
                            <Label text="Интернет-радио" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label text="Введите URL станции, чтобы добавить её в историю или запустить." wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>

                            <ComboBox fx:id="urlLink"
                                      editable="true"
                                      promptText="Укажите url радио"
                                      HBox.hgrow="ALWAYS"
                                      maxWidth="Infinity"/>
                            <Button text="▶ Включить радио" onAction="#setRadioTrue" maxWidth="Infinity"/>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <VBox fx:id="logPanel" visible="false" managed="false" spacing="5.0" style="-fx-border-color: #ccc; -fx-border-width: 1 0 0 0;" styleClass="VBox">
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="8.0"/>
            </padding>
            <Label text="Журнал событий (логи):" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
            <TextArea fx:id="logArea" prefHeight="100.0" editable="false" wrapText="true" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px;"/>
        </VBox>
    </bottom>

</BorderPane>